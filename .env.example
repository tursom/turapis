# Codex Auto-Login Test Configuration
# Copy this file to .env and adjust values for your environment

# HTTP/SOCKS5 proxy for integration tests (optional, for network-restricted environments)
EMAIL_TEST_PROXY=http://192.168.0.1:2080

# browserless/chromium WebSocket endpoint (for Wave 2 browser automation)
BROWSERLESS_URL=ws://localhost:3000/chromium
BROWSERLESS_TOKEN=
